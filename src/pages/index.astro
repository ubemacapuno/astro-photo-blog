---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
import ImageCarousel from "../components/vue/ImageCarousel.vue";
import GitHubCard from "../components/GitHubCard.astro";
import { person, projects, SITE_NAME, SITE_URL } from "../consts";
import type { CarouselImage } from "../types";
import { Icon } from "astro-icon/components";

const pageTitle = "";
const seo = {
  title: "Corey Damocles - Developer and Photographer",
  description:
    "Corey Damocles is a software developer and photographer who specializes in building web applications and film photography.",
  url: new URL(Astro.url.pathname, SITE_URL).href,
  image: new URL("/images/hero-1.jpg", SITE_URL).href,
  structuredData: {
    "@context": "https://schema.org",
    "@graph": [
      person,
      {
        "@type": "WebSite",
        "@id": `${SITE_URL}/#website`,
        name: SITE_NAME,
        url: SITE_URL,
        publisher: { "@id": person["@id"] },
      },
    ],
  },
};
const allPosts = await getCollection("blog");

const carouselImages: CarouselImage[] = [
  {
    src: "/images/hero-5.webp",
    alt: "Film photo of a climber in the crack between two split desert boulders, friends watching from below",
  },
  {
    src: "/images/hero-7.webp",
    alt: "Double-exposure film portrait of a woman's silhouette filled with a foggy coastal headland",
  },
  {
    src: "/images/hero-4.webp",
    alt: "Film photo looking down into a missile silo at the nose cone of a Titan II rocket",
  },
  {
    src: "/images/hero-3.webp",
    alt: "Double-exposure film portrait of a man's profile filled with oak leaves against a blue sky",
  },
  {
    src: "/images/hero-6.webp",
    alt: "Overhead film photo of friends on a sunny bouldering trail",
  },
  {
    src: "/images/hero-1.webp",
    alt: "Film portrait of a woman in a white cap under neon lights at night",
  },
  {
    src: "/images/hero-2.webp",
    alt: "Film photo of a hiker leaping across the top of a sandstone cliff above green brush",
  },
  {
    src: "/images/hero-8.webp",
    alt: "Double-exposure film photo of people silhouetted at a coastal overlook, layered with a fence of love locks",
  },
];

// Sort posts by pub_date (newest first)
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pub_date.getTime() - a.data.pub_date.getTime(),
);
---

<BaseLayout {pageTitle} seo={seo}>
  <section class="flex justify-center items-start whitespace-nowrap">
    <div class="relative flex items-center justify-center">
      <div
        class="relative w-screen aspect-352/500 sm:w-88 sm:h-125 sm:aspect-auto md:w-103.75 md:h-147.5"
      >
        <div id="carousel-wrapper" class="relative flex flex-col w-full h-full">
          <!-- Static LCP image in initial HTML so the browser discovers it immediately -->
          <img
            src={carouselImages[0].src}
            alt={carouselImages[0].alt}
            width="415"
            height="590"
            fetchpriority="high"
            class="absolute inset-0 w-full h-full object-cover object-center"
            aria-hidden="true"
          />
          <ImageCarousel client:idle images={carouselImages} />
          <small
            data-fade-group="hero-title"
            class="sm:hidden absolute top-full right-0 mt-2 mr-4 font-serif text-base font-normal italic text-black dark:text-white normal-case tracking-tight transition-opacity duration-500"
          >
            Shot on Film
          </small>
        </div>
      </div>

      <div class="absolute z-10 flex flex-col items-center text-center">
        <h1
          id="corey-damocles"
          data-fade-group="hero-title"
          class="block text-5xl sm:text-7xl md:text-8xl lg:text-8xl text-center text-red-600 uppercase whitespace-nowrap anton-regular tracking-wide cursor-pointer transition-opacity duration-1000"
        >
          Corey Damocles
        </h1>
        <small
          id="shot-on-film-desktop"
          data-fade-group="hero-title"
          class="hidden sm:block self-end font-serif text-base font-normal italic text-black dark:text-white normal-case tracking-tight transition-opacity duration-1000"
        >
          Shot on Film
        </small>
      </div>
    </div>
  </section>

  <section class="flex flex-col mt-24">
    <div class="flex justify-between">
      <h2 class="text-3xl font-bold">Recent Posts</h2>
      <a
        href="/blog/"
        data-astro-prefetch
        class="plain-link"
        aria-label="Link to Blogs"
      >
        <Icon name="mdi:newspaper-variant" size={36} />
      </a>
    </div>
    <BlogPost
      allPosts={sortedPosts.slice(0, 2).map((blog) => ({
        url: `/blogs/${blog.id}/`,
        frontmatter: {
          title: blog.data.title,
          author: blog.data.author,
          description: blog.data.description,
          pub_date: blog.data.pub_date,
          type: blog.data.type,
          image: blog.data.image,
          tags: blog.data.tags,
          photo_date: blog.data.photo_date,
        },
      }))}
    />

    <a
      href="/blog/"
      data-astro-prefetch
      class="plain-link self-end inline-flex items-center gap-1.5 text-sm font-medium text-text-muted transition-colors hover:text-text-primary"
    >
      See all posts <span aria-hidden="true">&rarr;</span>
    </a>
  </section>

  <section class="flex flex-col mt-12">
    <div class="flex justify-between">
      <h2 class="text-3xl font-bold">Projects on GitHub</h2>
      <a
        href="https://www.github.com/ubemacapuno"
        class="plain-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Link to GitHub profile"
      >
        <Icon name="mdi:github" size={36} />
      </a>
    </div>
    {
      projects.map((project) => (
        <div class="my-2">
          <GitHubCard gitHubCard={project} />
        </div>
      ))
    }
  </section>

  <script is:inline data-astro-rerun>
    (function () {
      const fadeDurationMs = 8 * 3050;
      const heroTitleFadeGroup = "hero-title";
      let isTitleHidden = false;
      let restoreTitleTimeout = null;

      const heroTitleElements = document.querySelectorAll(
        '[data-fade-group="' + heroTitleFadeGroup + '"]',
      );

      const heroTitleElement = document.getElementById("corey-damocles");
      if (heroTitleElement === null) return;

      function setTitleOpacity(opacityValue) {
        const shouldHide = opacityValue === "0";
        for (let index = 0; index < heroTitleElements.length; index++) {
          const element = heroTitleElements[index];
          element.style.opacity = opacityValue;
          element.style.pointerEvents = shouldHide ? "none" : "auto";
          element.setAttribute("aria-hidden", String(shouldHide));
        }
      }

      heroTitleElement.addEventListener("click", function () {
        if (isTitleHidden) return;
        if (restoreTitleTimeout !== null) clearTimeout(restoreTitleTimeout);

        isTitleHidden = true;
        setTitleOpacity("0");

        restoreTitleTimeout = setTimeout(function () {
          setTitleOpacity("1");
          isTitleHidden = false;
          restoreTitleTimeout = null;
        }, fadeDurationMs);
      });
    })();
  </script>
</BaseLayout>
