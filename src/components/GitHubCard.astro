---
import { Icon } from "astro-icon/components";
import type { GitHubCard } from "../types";
import { languageColors } from "../consts";

interface Props {
  gitHubCard: GitHubCard;
}

const { gitHubCard } = Astro.props as Props;
const DEFAULT_LANGUAGE_COLOR = "var(--color-text-muted)";
const languages = gitHubCard.stack.map((language) => ({
  language,
  color: languageColors[language] ?? DEFAULT_LANGUAGE_COLOR,
}));
const showStars = gitHubCard.stars > 0;
const showForks = gitHubCard.forks > 1;
---

<a
  href={gitHubCard.url}
  data-astro-prefetch
  class="blog-card-link group block text-inherit font-normal"
>
  <div
    class="flex flex-col overflow-hidden rounded-xl border border-card-border bg-card-bg px-5 py-4 transition-colors duration-200 group-hover:border-text-muted"
  >
    <div class="flex-1">
      <h2 class="text-lg font-bold mb-3 text-text-primary">
        {gitHubCard.name}
      </h2>
      <p class="text-sm text-text-muted">
        {gitHubCard.description}
      </p>
      <div class="flex justify-between">
        <div class="flex flex-wrap gap-1.5 mt-2">
          {
            languages.map(({ language, color }) => (
              <div class="flex gap-1.5 px-1">
                <span
                  class="rounded-full px-2 py-0.5 text-xs font-medium"
                  style={`background-color: ${color}`}
                />
                <p class="text-xs text-text-muted">
                  {language}
                </p>
              </div>
            ))
          }
        </div>
        {
          (showStars || showForks) && (
            <p class="text-xs text-text-muted flex items-center gap-2">
              {showStars && (
                <span class="flex items-center gap-0.5">
                  <Icon name="mdi:star" size={18} />
                  {gitHubCard.stars}
                </span>
              )}
              {showForks && (
                <span class="flex items-center gap-0.5">
                  <Icon name="mdi:source-fork" size={18} />
                  {gitHubCard.forks}
                </span>
              )}
            </p>
          )
        }
      </div>
    </div>
  </div>
</a>
